{
  "name": "Física Computacional I (SymPy)",
  // Imagen de Python 3.11 del curso; ver el comentario en el Dockerfile
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    // gh pr create desde la terminal (semana 3 en adelante)
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // gh codespace ssh/cp: revisión en lote desde la terminal local (docs/autograding.md)
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  // Versiones fijas del curso + filtro nbstripout (que en local se activa a mano)
  "postCreateCommand": "pip install -r requirements.txt && nbstripout --install --attributes .gitattributes",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
