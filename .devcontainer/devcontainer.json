{
  "name": "Física Computacional I (SymPy)",
  // Python 3.11 = mínimo del curso (docs/instalacion.md) y versión del workflow de autograding
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    // gh pr create desde la terminal (semana 3 en adelante)
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Versiones fijas del curso + filtro nbstripout (que en local se activa a mano)
  "postCreateCommand": "pip install -r requirements.txt && nbstripout --install --attributes .gitattributes",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
